source [file join [file dirname [info script]] _common.exp]

set timeout 120

set remote_cmd {set -e
SERVICE=/etc/systemd/system/pi-agent-web.service
if ! test -f "$SERVICE"; then echo FETCH_FAIL:no_service; exit 1; fi
get_env() { grep -m1 "^Environment=$1=" "$SERVICE" | sed "s/^Environment=$1=//"; }
TOKEN=$(get_env PI_WEB_REMOTE_TOKEN)
SSO=$(get_env PI_LIVO_SSO_VERIFY_TOKEN)
SECRET=$(get_env PI_LIVO_SESSION_SECRET)
printf '%s' "$TOKEN" > /tmp/pi_livo_remote_token.txt
printf '%s' "$SSO" > /tmp/pi_livo_sso_verify_token.txt
printf '%s' "$SECRET" > /tmp/pi_livo_session_secret.txt
echo FETCH_OK
}

ops_ssh $remote_cmd 120

proc ops_scp_from_remote {remote_path local_path {timeout_sec 120}} {
    global password host
    set timeout $timeout_sec
    spawn scp -o StrictHostKeyChecking=no ${host}:$remote_path $local_path
    expect {
        -re ".*yes/no.*" { send "yes\r"; exp_continue }
        -re ".*password:.*" { send "$password\r"; exp_continue }
        timeout { send_user "SCP TIMEOUT\n"; exit 1 }
        eof
    }
}

ops_scp_from_remote /tmp/pi_livo_remote_token.txt /tmp/pi_livo_remote_token.txt 60
ops_scp_from_remote /tmp/pi_livo_sso_verify_token.txt /tmp/pi_livo_sso_verify_token.txt 60
ops_scp_from_remote /tmp/pi_livo_session_secret.txt /tmp/pi_livo_session_secret.txt 60
